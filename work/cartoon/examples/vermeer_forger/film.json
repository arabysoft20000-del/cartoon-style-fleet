 "voice": {
  "file": "voice/vo.wav",
  "words": "voice/words.json",
  "lines": [
   {
    "who": null,
    "text": "عشان يهرب من تهمة الخيانة العظمى والتعاون مع النازيين"
   },
   {
    "who": null,
    "text": "هان فان ميجرين ما لقاش قدامه غير حل واحد"
   },
   {
    "who": null,
    "text": "إنه يعترف إنه نصاب"
   },
   {
    "who": null,
    "text": "سنة 1945 السلطات الهولندية قبضت على"
   },
   {
    "who": null,
    "text": "هان بعد ما لقوا لوحة نادرة للفنان الشهير فيرمير"
   },
   {
    "who": null,
    "text": "في حوزة هيرمان جورينج واحد من أكبر قادة النازيين"
   },
   {
    "who": null,
    "text": "التهمة كانت واضحة بيع كنز من تراث البلد للعدو"
   },
   {
    "who": null,
    "text": "وعقوبتها الإعدام"
   },
   {
    "who": null,
    "text": "لكن هان فجر مفاجأة قدام المحققين"
   },
   {
    "who": null,
    "text": "اللوحة دي مش أصلية أنا اللي راسمها بإيدي"
   },
   {
    "who": null,
    "text": "المشكلة إن ما فيش حد صدقه"
   },
   {
    "who": null,
    "text": "اللوحات كانت مخدعة كبار الخبراء لدرجة إنهم اعتبروها أصلية 100%"
   },
   {
    "who": null,
    "text": "تخيل توصل لمرحلة من الإتقان في الكدب"
   },
   {
    "who": null,
    "text": "لدرجة إنك لما تقول الحقيقة ما حدش يصدقك"
   },
   {
    "who": null,
    "text": "عشان يثبت كلامه هان اضطر يمسك الفرشة تاني"
   },
   {
    "who": null,
    "text": "تحت رقابة صارمة قعد شهور يرسم لوحة جديدة"
   },
   {
    "who": null,
    "text": "بنفس أسلوب فيرمير القديم"
   },
   {
    "who": null,
    "text": "وفي نفس الوقت التحليلات العلمية للوحاته القديمة"
   },
   {
    "who": null,
    "text": "كشفت عن مواد كيميائية ما كانتش موجودة أصلاً في عصر فيرمير"
   },
   {
    "who": null,
    "text": "فعلاً تهمة الخيانة اتشالت"
   },
   {
    "who": null,
    "text": "لكن هان ما خرجش بريء"
   },
   {
    "who": null,
    "text": "سنة 1947 صدر حكم بسجنه سنة كاملة"
   },
   {
    "who": null,
    "text": "بتهمة التزوير والاحتيال"
   },
   {
    "who": null,
    "text": "خرج من التهمة الأخطر لما أثبت للكل إنه فعلاً مجرم"
   },
   {
    "who": null,
    "text": "بس من نوع تاني خالص"
   }
  ]
 },
