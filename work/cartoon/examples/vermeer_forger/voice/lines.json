[
 {
  "n": 1,
  "line": 1,
  "who": "narrator",
  "text": "عشان يهرب من تهمة الخيانة العظمى والتعاون مع النازيين",
  "start": 0.02,
  "end": 3.1
 },
 {
  "n": 2,
  "line": 2,
  "who": "narrator",
  "text": "هان فان ميجرين ما لقاش قدامه غير حل واحد",
  "start": 3.46,
  "end": 6.12
 },
 {
  "n": 3,
  "line": 3,
  "who": "narrator",
  "text": "إنه يعترف إنه نصاب",
  "start": 6.62,
  "end": 7.78
 },
 {
  "n": 4,
  "line": 4,
  "who": "narrator",
  "text": "سنة 1945 السلطات الهولندية قبضت على",
  "start": 8.63,
  "end": 12.04
 },
 {
  "n": 5,
  "line": 5,
  "who": "narrator",
  "text": "هان بعد ما لقوا لوحة نادرة للفنان الشهير فيرمير",
  "start": 12.04,
  "end": 15.17
 },
 {
  "n": 6,
  "line": 6,
  "who": "narrator",
  "text": "في حوزة هيرمان جورينج واحد من أكبر قادة النازيين",
  "start": 15.6,
  "end": 19.22
 },
 {
  "n": 7,
  "line": 7,
  "who": "narrator",
  "text": "التهمة كانت واضحة بيع كنز من تراث البلد للعدو",
  "start": 19.94,
  "end": 22.79
 },
 {
  "n": 8,
  "line": 8,
  "who": "narrator",
  "text": "وعقوبتها الإعدام",
  "start": 23.02,
  "end": 24.0
 },
 {
  "n": 9,
  "line": 9,
  "who": "narrator",
  "text": "لكن هان فجر مفاجأة قدام المحققين",
  "start": 24.78,
  "end": 27.26
 },
 {
  "n": 10,
  "line": 10,
  "who": "narrator",
  "text": "اللوحة دي مش أصلية أنا اللي راسمها بإيدي",
  "start": 27.82,
  "end": 30.27
 },
 {
  "n": 11,
  "line": 11,
  "who": "narrator",
  "text": "المشكلة إن ما فيش حد صدقه",
  "start": 30.96,
  "end": 32.51
 },
 {
  "n": 12,
  "line": 12,
  "who": "narrator",
  "text": "اللوحات كانت مخدعة كبار الخبراء لدرجة إنهم اعتبروها أصلية 100%",
  "start": 33.05,
  "end": 37.66
 },
 {
  "n": 13,
  "line": 13,
  "who": "narrator",
  "text": "تخيل توصل لمرحلة من الإتقان في الكدب",
  "start": 38.29,
  "end": 40.64
 },
 {
  "n": 14,
  "line": 14,
  "who": "narrator",
  "text": "لدرجة إنك لما تقول الحقيقة ما حدش يصدقك",
  "start": 41.06,
  "end": 43.54
 },
 {
  "n": 15,
  "line": 15,
  "who": "narrator",
  "text": "عشان يثبت كلامه هان اضطر يمسك الفرشة تاني",
  "start": 44.34,
  "end": 46.85
 },
 {
  "n": 16,
  "line": 16,
  "who": "narrator",
  "text": "تحت رقابة صارمة قعد شهور يرسم لوحة جديدة",
  "start": 47.42,
  "end": 50.23
 },
 {
  "n": 17,
  "line": 17,
  "who": "narrator",
  "text": "بنفس أسلوب فيرمير القديم",
  "start": 50.56,
  "end": 51.9
 },
 {
  "n": 18,
  "line": 18,
  "who": "narrator",
  "text": "وفي نفس الوقت التحليلات العلمية للوحاته القديمة",
  "start": 52.44,
  "end": 55.42
 },
 {
  "n": 19,
  "line": 19,
  "who": "narrator",
  "text": "كشفت عن مواد كيميائية ما كانتش موجودة أصلاً في عصر فيرمير",
  "start": 55.82,
  "end": 59.33
 },
 {
  "n": 20,
  "line": 20,
  "who": "narrator",
  "text": "فعلاً تهمة الخيانة اتشالت",
  "start": 60.11,
  "end": 61.61
 },
 {
  "n": 21,
  "line": 21,
  "who": "narrator",
  "text": "لكن هان ما خرجش بريء",
  "start": 62.02,
  "end": 63.55
 },
 {
  "n": 22,
  "line": 22,
  "who": "narrator",
  "text": "سنة 1947 صدر حكم بسجنه سنة كاملة",
  "start": 64.1,
  "end": 67.79
 },
 {
  "n": 23,
  "line": 23,
  "who": "narrator",
  "text": "بتهمة التزوير والاحتيال",
  "start": 68.03,
  "end": 69.53
 },
 {
  "n": 24,
  "line": 24,
  "who": "narrator",
  "text": "خرج من التهمة الأخطر لما أثبت للكل إنه فعلاً مجرم",
  "start": 70.37,
  "end": 74.13
 },
 {
  "n": 25,
  "line": 25,
  "who": "narrator",
  "text": "بس من نوع تاني خالص",
  "start": 74.77,
  "end": 75.9
 }
]
