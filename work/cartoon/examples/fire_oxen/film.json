 "voice": {
  "file": "voice/vo.wav",
  "words": "voice/words.json",
  "lines": [
   {
    "who": null,
    "text": "ديل التور بيولع وهو مش فاهم ليه بيجري ناحية الضلمة وقدامه معسكر جيش كامل"
   },
   {
    "who": null,
    "text": "بعد حصار استمر خمس سنين كانت مدينة جيمو واحدة من آخر مدينتين بعد ما أكتر من 70 مدينة وقعت في مملكة شي"
   },
   {
    "who": null,
    "text": "والعدو حاطط إيده في مية باردة"
   },
   {
    "who": null,
    "text": "جوه الأسوار موظف صغير في السوق اسمه تيان دان لا كان قائد ولا جندي بس لقى نفسه مسؤول عن مصير المدينة فقرر يعمل حركة جنونية"
   },
   {
    "who": null,
    "text": "جمع حوالي 1000 تور لبسهم أقمشة حمرا مرسوم عليها تنانين وربط نصال في قرونهم وحزم قش مليانة زيت في ديولهم"
   },
   {
    "who": null,
    "text": "ولما الليل نزل حفروا فتحات في سور المدينة وولعوا في الديول"
   },
   {
    "who": null,
    "text": "التيران جريت زي المجنونة ناحية معسكر العدو ووراهم 5000 جندي وأهل المدينة بيخبطوا على الطبول والأواني المعدن دوشة تزلزل الأرض"
   },
   {
    "who": null,
    "text": "جنود العدو ما كانوش مصدقين عينيهم في الضلمة شافوا كائنات زي التنانين الحمرا نار في ديولهم وما لحقوش يفكروا"
   },
   {
    "who": null,
    "text": "في لحظات المعسكر انهار والقائد اتقتل ومن هنا كانت الشرارة اللي خلت السبعين مدينة يرجعوا تاني لأهلهم"
   }
  ]
 },
